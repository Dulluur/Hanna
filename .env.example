# Пример окружения для прод-деплоя (docker-compose.prod.yml).
# Скопируй в .env на сервере и подставь реальные значения. .env в git НЕ коммитим.

# --- Домен (nginx + certbot выпустят под него HTTPS-сертификат Let's Encrypt) ---
DOMAIN=example.ru
# Почта для Let's Encrypt: нужна скрипту init-letsencrypt.sh при первом выпуске
# сертификата (туда придут уведомления об истечении).
ACME_EMAIL=admin@example.ru

# --- PostgreSQL (сервис db) ---
POSTGRES_USER=hanna
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=hanna

# --- Backend ---
# Хост БД = имя сервиса 'db' внутри compose-сети. Пароль/юзер/база — как выше.
DATABASE_URL=postgresql+asyncpg://hanna:CHANGE_ME_strong_db_password@db:5432/hanna
ENV=production
# Случайный секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_random_secret
# Из этих кредов сидер создаёт администратора (вход в /admin).
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
# На проде фронт и API на одном домене → CORS почти не нужен, но укажем домен.
CORS_ORIGINS=https://example.ru
